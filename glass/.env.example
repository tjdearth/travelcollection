# Glass Environment Configuration
# Copy to .env and fill in your values

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Salesforce (production — JWT bearer flow via SSO)
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=your_connected_app_client_id
SF_USERNAME=integration@travelcollection.com
SF_PRIVATE_KEY=  # Base64-encoded private key for JWT bearer flow

# Salesforce (development — username/password fallback)
# SF_PASSWORD=your_password
# SF_SECURITY_TOKEN=your_security_token

# Glass
GLASS_ENV=development
MCP_SALESFORCE_URL=http://localhost:3001/sse
